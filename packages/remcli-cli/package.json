{
  "name": "remcli",
  "version": "0.0.1",
  "description": "Remote control for AI agents",
  "author": "Sergei Petrosyan",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/spetrosyan94/remcli",
  "bugs": "https://github.com/spetrosyan94/remcli/issues",
  "repository": "spetrosyan94/remcli",
  "bin": {
    "remcli": "./bin/remcli.mjs",
    "remcli-mcp": "./bin/remcli-mcp.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./lib": {
      "require": {
        "types": "./dist/lib.d.cts",
        "default": "./dist/lib.cjs"
      },
      "import": {
        "types": "./dist/lib.d.mts",
        "default": "./dist/lib.mjs"
      }
    },
    "./codex/remcliMcpStdioBridge": {
      "require": {
        "types": "./dist/codex/remcliMcpStdioBridge.d.cts",
        "default": "./dist/codex/remcliMcpStdioBridge.cjs"
      },
      "import": {
        "types": "./dist/codex/remcliMcpStdioBridge.d.mts",
        "default": "./dist/codex/remcliMcpStdioBridge.mjs"
      }
    }
  },
  "files": [
    "dist",
    "web-dist",
    "bin",
    "scripts",
    "tools",
    "src/daemon/tts/*.py",
    "src/daemon/tts/voices/**",
    "package.json"
  ],
  "scripts": {
    "why do we need to build before running tests / dev?": "We need the binary to be built so we run daemon commands which directly run the binary - we don't want them to go out of sync or have custom spawn logic depending how we started remcli",
    "typecheck": "tsc --noEmit",
    "build": "shx rm -rf dist && npx tsc --noEmit && pkgroll 2>/dev/null && node scripts/copy-web-dist.cjs",
    "test": "$npm_execpath run build && vitest run",
    "start": "$npm_execpath run build && node ./bin/remcli.mjs",
    "start:tunnel": "$npm_execpath run build && node ./bin/remcli.mjs daemon start-sync --tunnel",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "$npm_execpath run build && $npm_execpath test",
    "release": "$npm_execpath install && release-it",
    "postinstall": "node scripts/unpack-tools.cjs",
    "// ==== Setup ====": "",
    "setup:dev": "node scripts/setup-dev.cjs",
    "doctor": "node ./bin/remcli.mjs doctor",
    "// ==== Development Linking ====": "",
    "link:dev": "node scripts/link-dev.cjs",
    "unlink:dev": "node scripts/link-dev.cjs unlink"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.8.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@inquirer/prompts": "^7.10.1",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/ps-list": "^6.2.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/tmp": "^0.2.6",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "cross-spawn": "^7.0.6",
    "fastify": "^5.6.2",
    "fastify-type-provider-zod": "4.0.2",
    "ink": "^6.5.1",
    "node-edge-tts": "^1.2.10",
    "node-wav": "^0.0.2",
    "open": "^10.2.0",
    "ps-list": "^8.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "smart-whisper": "^0.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.1",
    "tar": "^7.5.2",
    "tmp": "^0.2.5",
    "tweetnacl": "^1.0.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "@vitest/coverage-v8": "3.2.4",
    "dotenv": "^16.6.1",
    "pkgroll": "^2.14.2",
    "release-it": "^19.0.6",
    "shx": "^0.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "ws": "^8.21.1"
  },
  "resolutions": {
    "whatwg-url": "14.2.0",
    "parse-path": "7.0.3",
    "@types/parse-path": "7.0.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
