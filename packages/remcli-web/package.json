{
    "name": "remcli-web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit",
        "test": "vitest run",
        "check:i18n": "node scripts/check-translations.mjs",
        "test:e2e": "playwright test e2e/design-smoke.spec.ts e2e/route-error-boundary.spec.ts e2e/chat-lineage.spec.ts e2e/permission-feedback.spec.ts",
        "test:visual": "playwright test --config=playwright.visual.config.ts e2e/design-visual.spec.ts",
        "test:visual:update": "playwright test --config=playwright.visual.config.ts e2e/design-visual.spec.ts --update-snapshots=all",
        "test:design-contract": "playwright test --config=playwright.visual.config.ts e2e/design-contract.spec.ts"
    },
    "dependencies": {
        "@fontsource/geist": "^5.2.9",
        "@fontsource/geist-mono": "^5.2.8",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.23.0",
        "radix-ui": "^1.6.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router": "^8.1.0",
        "socket.io-client": "^4.8.3",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tweetnacl": "^1.0.3",
        "vaul": "^1.1.2",
        "zod": "3.25.76",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@playwright/test": "^1.61.1",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "4.1.9",
        "axe-core": "4.12.1",
        "@tailwindcss/vite": "^4.3.2",
        "tailwindcss": "^4.3.2",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "~6.0.2",
        "vite": "^8.1.1",
        "vitest": "^4.1.9"
    },
    "optionalDependencies": {
        "@esbuild/linux-x64": "0.27.2",
        "@rollup/rollup-linux-x64-gnu": "4.57.0",
        "@tailwindcss/oxide-linux-x64-gnu": "4.3.2",
        "lightningcss-linux-x64-gnu": "1.32.0"
    }
}
